{
  "name": "aot-release-apk",
  "version": "1.0.0",
  "description": "拖入 APK 自动生成符合第三方抓取规范的 GitHub Release",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node test/test-github-release.js && node test/test-apk-inspector.js",
    "test:spec": "node test/test-github-release.js",
    "test:apk": "node test/test-apk-inspector.js"
  },
  "keywords": [
    "apk",
    "release",
    "github-release"
  ],
  "author": "zhijiayun",
  "license": "ISC"
}
